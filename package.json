{
  "name": "booyah-rsvp",
  "version": "1.0.0",
  "description": "Booyah Awards 2026 — RSVP system",
  "main": "src/server.js",
  "scripts": {
    "build:css": "tailwindcss -i src/css/input.css -o public/styles.css --minify",
    "watch:css": "tailwindcss -i src/css/input.css -o public/styles.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"nodemon src/server.js\"",
    "build": "npm run build:css",
    "start": "node src/server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^128.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "tailwindcss": "^4.3.0"
  }
}
