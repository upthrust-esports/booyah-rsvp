# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── RSVP Page URL (your Render URL after deploy) ─────
RSVP_PAGE_URL=https://your-app.onrender.com/rsvp.html

# ─── Google Sheets (Apps Script backend) ──────────────
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─── WhatsApp Business API (Meta) ─────────────────────
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
# WA message template — use {name} and {link} as placeholders
WA_TEMPLATE=Hi {name} 👋\n\nYou have a confirmed ticket for *The Booyah Awards 2026* 🎮🔥\n\n📅 6 June 2026 | 12:30 PM IST\n📍 India Expo Centre, Greater Noida\n\nConfirm your attendance 👇\n{link}

# ─── Email (SMTP) ──────────────────────────────────────
# Option A: Gmail (use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Option B: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key

EMAIL_FROM_NAME=The Booyah Awards 2026
EMAIL_FROM=noreply@upthrust.in
EMAIL_SUBJECT=You're invited — Confirm your attendance 🎉

# ─── Admin Auth (simple password protect the admin panel) ─
ADMIN_PASSWORD=changeme123
